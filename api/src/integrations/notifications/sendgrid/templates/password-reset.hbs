<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset your password</title>
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
    <tr>
      <td align="center" style="padding:24px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:520px;border:1px solid #d6d3d1;border-radius:12px;">
          <tr>
            <td style="padding:24px 24px 16px;text-align:center;">
              <h1 style="margin:0;font-size:24px;font-weight:700;color:#d97706;">
                {{appName}}
              </h1>
              <p style="margin:6px 0 0;font-size:14px;color:#78716c;">Password reset request</p>
            </td>
          </tr>
          <tr>
            <td style="padding:0 24px 24px;">
              <p style="margin:0 0 12px;font-size:15px;line-height:1.5;color:#44403c;">
                Hi {{username}},
              </p>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.5;color:#57534e;">
                We received a request to reset your password. Click the button below to choose a new one. This link expires in {{expiresInMinutes}} minutes.
              </p>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                  <td align="center" style="padding:0 0 20px;">
                    <a href="{{resetUrl}}" style="display:inline-block;padding:12px 28px;background-color:#d97706;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;border-radius:8px;">
                      Reset password
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 6px;font-size:13px;line-height:1.5;color:#78716c;">
                If the button does not work, copy and paste this link into your browser:
              </p>
              <p style="margin:0 0 16px;font-size:12px;line-height:1.5;color:#d97706;word-break:break-all;">
                {{resetUrl}}
              </p>
              <p style="margin:0;font-size:13px;line-height:1.5;color:#a8a29e;">
                If you did not request a password reset, you can safely ignore this email. Your password will remain unchanged.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 24px;border-top:1px solid #e7e5e4;text-align:center;">
              <p style="margin:0;font-size:12px;color:#a8a29e;">
                &copy; {{year}} {{appName}}. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
