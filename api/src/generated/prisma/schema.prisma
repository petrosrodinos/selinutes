// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  username      String    @unique
  email         String    @unique
  password      String
  role          AuthRole
  date_of_birth DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  stats                 UserStats?
  games                 Game[]
  password_reset_tokens PasswordResetToken[]
  orders                Order[]

  @@index([email])
  @@index([uuid])
  @@map("users")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_uuid  String
  token_hash String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@index([user_uuid])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model UserStats {
  id           Int      @id @default(autoincrement())
  user_uuid    String   @unique
  rank         Int      @default(0)
  level        Int      @default(1)
  points       Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  points_spent Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@map("user_stats")
}

model Game {
  id          Int        @id @default(autoincrement())
  uuid        String     @unique @default(uuid())
  user_uuid   String
  code        String?
  board_size  String
  mode        GameMode
  status      GameStatus
  time        Int?
  moves       Int        @default(0)
  points      Int        @default(0)
  logs        Json?
  created_at  DateTime   @default(now())
  finished_at DateTime?
  user        User       @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@index([uuid])
  @@index([user_uuid])
  @@map("games")
}

model Product {
  id             Int           @id @default(autoincrement())
  uuid           String        @unique @default(uuid())
  name           String
  description    String
  type           ProductType
  payment_method PaymentMethod
  price          Int
  quantity       Int           @default(1)
  image_path     String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  files  ProductFile[]
  images ProductImage[]
  orders Order[]

  @@index([type])
  @@map("products")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  product_uuid String
  path         String
  created_at   DateTime @default(now())
  product      Product  @relation(fields: [product_uuid], references: [uuid], onDelete: Cascade)

  @@index([product_uuid])
  @@map("product_images")
}

model ProductFile {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  product_uuid String
  name         String
  path         String
  size         Int
  content_type String
  created_at   DateTime @default(now())
  product      Product  @relation(fields: [product_uuid], references: [uuid], onDelete: Cascade)

  @@index([product_uuid])
  @@map("product_files")
}

model Order {
  id                       Int           @id @default(autoincrement())
  uuid                     String        @unique @default(uuid())
  user_uuid                String
  product_uuid             String
  status                   OrderStatus   @default(pending)
  payment_method           PaymentMethod
  total                    Int
  stripe_session_id        String?
  stripe_payment_intent_id String?
  paid_at                  DateTime?
  cancelled_at             DateTime?
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt
  user                     User          @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  product                  Product       @relation(fields: [product_uuid], references: [uuid])

  @@index([user_uuid])
  @@index([product_uuid])
  @@index([status])
  @@map("orders")
}

enum ProductType {
  physical
  digital
  in_game_asset
}

enum PaymentMethod {
  points
  online
}

enum OrderStatus {
  pending
  paid
  cancelled
}

enum GameMode {
  SINGLE
  OFFLINE
  ONLINE
}

enum GameStatus {
  WIN
  LOSS
  DRAW
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}
